# Local development only. Do not commit real credentials.
POSTGRES_DB=knowledge_agent
POSTGRES_USER=knowledge_agent
POSTGRES_PASSWORD=change-me-locally
POSTGRES_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=5173
DIRETORIO_ARQUIVOS=/app/arquivos
# Gere um valor local com: openssl rand -hex 32
JWT_SECRET=troque-este-valor-por-um-segredo-local
EXPIRACAO_TOKEN_MINUTOS=60
OPENAI_API_KEY=
MODELO_EMBEDDING=text-embedding-3-small
MODELO_LLM=gpt-4.1-mini
TAMANHO_CHUNK=800
SOBREPOSICAO_CHUNK=120
MAX_TRECHOS_RECUPERADOS=5
# Limiar inicial para recuperação semântica multilíngue. Ajuste conforme a base crescer.
LIMIAR_SIMILARIDADE=0.30
MAX_TOKENS_CONTEXTO=4000
MAX_TOKENS_RESPOSTA=500
MAX_PAGINAS_PDF=5
